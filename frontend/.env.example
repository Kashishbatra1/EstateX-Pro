# Backend API base URL.
# Leave empty in development to use the Vite proxy (/api -> localhost:5000).
# For production builds, set the full backend origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Dev-only: Vite proxy target when VITE_API_BASE_URL is empty
VITE_PROXY_TARGET=http://localhost:5000
