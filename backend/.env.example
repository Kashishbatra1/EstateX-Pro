# EstateX Pro Backend — Environment Variables
# Copy to .env and fill in your local values.
# NEVER commit the real .env file.

NODE_ENV=development
PORT=5000

# PostgreSQL (estatex_pro)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estatex_pro
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT (Phase 2 Authentication) — use a long random secret
JWT_SECRET=change_me_in_phase_2
JWT_EXPIRES_IN=8h

# Frontend origin (used later for CORS)
CORS_ORIGIN=http://localhost:5173
