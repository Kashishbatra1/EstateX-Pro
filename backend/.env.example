# EstateX Pro Backend — Environment Variables
# Copy to .env and fill in your local values.
# NEVER commit the real .env file.

NODE_ENV=development
PORT=5000

# --- Database (choose ONE style) ---

# Local PostgreSQL (default for npm start):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=estatex_pro
DB_USER=postgres
DB_PASSWORD=your_password_here

# Hosted / Neon / Vercel — when set, DATABASE_URL is preferred over DB_* above:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# JWT (Phase 2 Authentication) — use a long random secret
JWT_SECRET=change_me_in_phase_2
JWT_EXPIRES_IN=8h

# Frontend origin(s) for CORS — comma-separated for multiple
# Local default:
CORS_ORIGIN=http://localhost:5173
# Production example (set in Vercel; do not invent a URL here):
# CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# Optional: reminder interval for local long-running process only (ms)
# REMINDER_INTERVAL_MS=3600000
